# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memeini_db?schema=public"

# Authentication (JWT)
JWT_ACCESS_SECRET=super_secret_access_key_memeini_2026_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_memeini_2026_change_in_production
JWT_REFRESH_EXPIRATION=30d

# Storage Configuration
# Options: 'local' (files stored in ./uploads) or 's3' (AWS S3, Cloudflare R2, MinIO, Supabase)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# AWS S3 / Compatible Object Storage (Required if STORAGE_DRIVER=s3)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=memeini-media
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_DOMAIN=
