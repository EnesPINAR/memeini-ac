{
  "expo": {
    "name": "Meme'ini Bul",
    "slug": "memeiniac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Baloo2-SemiBold.ttf",
            "./assets/fonts/Baloo2-Bold.ttf",
            "./assets/fonts/Baloo2-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Meme olarak yüklemek istediğiniz fotoğraf ve videoları seçebilmek için galeri erişimi gerekiyor.",
          "cameraPermission": "Anlık meme fotoğrafı veya videosu çekebilmek için kamera erişimi gerekiyor."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "3335e353-abe7-4fcb-99ed-d5163e679aa2"
      }
    },
    "owner": "enespinar"
  }
}
